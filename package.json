{
  "name": "shadertoy-audio-recorder",
  "version": "2.0.0",
  "description": "Enhanced ShaderToy Canvas Recorder with Audio Capture",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && vite build",
    "build:prod": "NODE_ENV=production vite build --mode production",
    "build:dev": "NODE_ENV=development vite build --mode development",
    "build:prod:safe": "NODE_ENV=production npm run type-check && vite build --mode production",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "validate:build": "npm run build:prod && npm run test:build",
    "test:build": "node scripts/validate-build.js",
    "analyze": "npm run build:prod -- --analyze",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.21",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/chrome": "^0.0.251",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/ui": "^3.2.4",
    "babel-plugin-react-remove-properties": "^0.3.0",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^26.1.0",
    "rollup-plugin-analyzer": "^4.0.0",
    "terser": "^5.43.1",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "vite-bundle-analyzer": "^0.7.0",
    "vitest": "^3.2.4"
  }
}
