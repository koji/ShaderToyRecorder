{
  "manifest_version": 3,
  "name": "ShaderToy Audio-Video Recorder",
  "version": "2.0.0",
  "description": "Enhanced ShaderToy Canvas Recorder with Audio Capture",
  "permissions": ["scripting", "activeTab", "tabCapture", "offscreen"],
  "action": {
    "default_popup": "src/popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://www.shadertoy.com/*"],
      "js": ["src/content/content.ts"]
    }
  ],
  "background": {
    "service_worker": "src/background/background.ts",
    "type": "module"
  },
  "host_permissions": ["*://www.shadertoy.com/"],
  "web_accessible_resources": [
    {
      "resources": ["src/offscreen/offscreen.html"],
      "matches": ["*://www.shadertoy.com/*"]
    }
  ]
}
